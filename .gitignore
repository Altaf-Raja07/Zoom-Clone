# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Database — generated by migrations on first run, never committed
*.db
*.sqlite3
data/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
.env*.local

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Playwright — anchored nowhere, because the frontend's own runs write into
# frontend/test-results/.
test-results/
playwright-report/
blob-report/
.playwright/.cache/

# Note: .scratch/ is intentionally NOT ignored. The tickets have no tracker to
# live in yet, so the repo is currently their only versioned home.
