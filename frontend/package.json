{
  "name": "meetly-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Meetly — a Zoom-style conferencing frontend. Next.js, CSS Modules, design tokens.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
